# Dedicated source-analysis worker; API keeps the smaller Dockerfile image.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.10.12 /uv /uvx /bin/
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    SOURCE_OCR_MODEL_DIR=/opt/farmclub/ocr

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --extra ocr
COPY . .
# Provision only at build time. Runtime verifies this manifest and every file.
RUN python -m app.source_analysis.provision_ocr "$SOURCE_OCR_MODEL_DIR" \
    && python -c "import rapidocr, onnxruntime"

# API owns migrations. Worker checks the existing schema before polling work.
CMD ["sh", "-c", "alembic current --check-heads && python -c 'from app.source_analysis.preprocess import _ocr_engine; _ocr_engine()' && exec python -m app.source_analysis.worker"]
