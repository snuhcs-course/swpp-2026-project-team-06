# 복사해서 server/.env로 쓴다. .env는 커밋하지 않는다. 빈 값은 app/core/config.py 기본값을 쓴다.

APP_ENV=

# DB (로컬 docker compose 기본: postgresql+psycopg://farmclub:farmclub@localhost:5432/farmclub)
DATABASE_URL=

# 인증 (DEV-4, ADR 0003)
JWT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 앱 주소 (CORS, 공유 링크 이동)
CONSUMER_APP_URL=
PRODUCER_APP_URL=

# 아래는 각 기능 이슈에서 config.py에 추가한다
# AI (ADR 0004)
ANTHROPIC_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# 지표·에러 (ADR 0005)
POSTHOG_API_KEY=
POSTHOG_HOST=
SENTRY_DSN=
# 파일 (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
