# 복사해서 server/.env로 쓴다. .env는 커밋하지 않는다. 빈 값은 app/core/config.py 기본값을 쓴다.

APP_ENV=

# DB (로컬 docker compose 기본: postgresql+psycopg://farmclub:farmclub@localhost:5432/farmclub)
DATABASE_URL=

# 인증 (ADR 0009). JWT_SECRET이 비면 local이 아닌 환경에서는 서버가 시작하지 않는다.
JWT_SECRET=
JWT_TTL_MINUTES=
# Mock 로그인(시드 테스트 계정). 운영 기본값은 꺼짐. 로컬 데모는 true
MOCK_LOGIN_ENABLED=
# 카카오 로그인 (ADR 0003, DEV-32). REST API 키가 비면 카카오 로그인은 꺼진다(GET /api/auth/kakao/config → enabled=false).
# 카카오 개발자 콘솔 리다이렉트 URI: <CONSUMER_APP_URL>/auth/kakao (생산자 앱은 <PRODUCER_APP_URL>/auth/kakao)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 앱 주소 (CORS, 공유 링크 이동, 카카오 복귀 주소 검증 DEV-32). 끝에 / 없이 정확히 적는다.
# 운영(ADR 0012): CONSUMER_APP_URL=https://farmclub.kr, PRODUCER_APP_URL=https://farm.farmclub.kr
CONSUMER_APP_URL=
PRODUCER_APP_URL=
# 공유 링크 앞부분. 운영은 https://farmclub.kr. 비우면 요청이 들어온 서버 주소
SHARE_BASE_URL=

# AI (ADR 0004). 키가 없으면 AI 초안은 실패로 처리한다(AC-03-3)
ANTHROPIC_API_KEY=
# spec-check(CI)가 실행 비용을 보고할 때 쓰는 공유 토큰(DEV-144). 비우면 POST /internal/spec-check-runs가 503
SPEC_CHECK_USAGE_TOKEN=
AI_MODEL=
AI_DRAFT_TIMEOUT_SECONDS=
AI_ANSWER_TIMEOUT_SECONDS=

# 자료 분석 (DEV-54). 기본 비활성; 기존 Claude 설정과 분리.
SOURCE_ANALYSIS_ENABLED=false
SOURCE_ANALYSIS_PROVIDER=mock
SOURCE_ANALYSIS_MODEL=google/gemini-3-flash-preview
OPENAI_API_KEY=
SOURCE_STORAGE=local
SOURCE_STORAGE_DIR=.artifacts/private-sources
SOURCE_R2_ENDPOINT=
SOURCE_R2_BUCKET=
SOURCE_R2_ACCESS_KEY=
SOURCE_R2_SECRET_KEY=
# 오프라인 배치한 한국어 OCR 모델과 manifest.json의 SHA-256
SOURCE_OCR_MODEL_DIR=
SOURCE_OCR_MODEL_SHA256=
SOURCE_PARSER_TIMEOUT=120
SOURCE_PARSER_MEMORY_MB=1024

# 홈 (FEAT-06)
HOME_RECOMMEND_LIMIT=
HOME_HERO_PRODUCT_ID=
# 무통장 입금 기한(시간). 입금 안내 시각부터 세고, 지나면 자동 취소·물량 해제(R-28, DEV-68)
DEPOSIT_DEADLINE_HOURS=

# 데모·테스트용 고정 시각(예: 2026-10-07T10:00:00+09:00). 비면 실제 시각
FIXED_NOW=

# 아래는 각 기능 이슈에서 config.py에 추가한다
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# 지표·에러 (ADR 0005)
POSTHOG_API_KEY=
POSTHOG_HOST=
SENTRY_DSN=
# 파일 (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# DEV-58: source analysis only; AI CS settings above remain independent.
OPENROUTER_API_KEY=
# SOURCE_ANALYSIS_PROVIDER=openrouter
# SOURCE_ANALYSIS_MODEL=google/gemini-3-flash-preview
SOURCE_VISUAL_MODEL=
SOURCE_OPENAI_FALLBACK_MODEL=
SOURCE_BUDGET_USD=5
SOURCE_EVALUATION_BUDGET_USD=1
SOURCE_EVALUATION=false
SOURCE_MAX_OUTPUT_TOKENS=4096
