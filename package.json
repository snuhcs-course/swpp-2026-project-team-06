{
  "name": "farmclub",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/local.mjs start",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:web": "node scripts/local.mjs export",
    "test:integration": "node scripts/test-integration.mjs",
    "test:e2e": "playwright test",
    "test:integration:full": "node scripts/run-integration.mjs",
    "test:mock": "tsc -p scripts/mock-tsconfig.json && node --test scripts/test-news-rooms.mjs scripts/test-spec12.mjs scripts/test-capacity.mjs scripts/test-navigation.mjs scripts/test-storefront.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:record:consumer": "node demo/record/consumer.mjs",
    "demo:record:producer": "node demo/record/producer.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  }
}
