{
  "expo": {
    "name": "farmclub-producer",
    "slug": "farmclub-producer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "farmclub-producer",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kr.farmclub.producer",
      "associatedDomains": [
        "applinks:farm.farmclub.kr"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "kr.farmclub.producer",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "farmclub 농가 앱이 사진·영상을 올리기 위해 사진 보관함을 사용해요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
