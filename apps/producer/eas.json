{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8000",
        "EXPO_PUBLIC_API_MOCK": "0"
      }
    },
    "preview": {
      "channel": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.farmclub.kr",
        "EXPO_PUBLIC_API_MOCK": "0",
        "EXPO_PUBLIC_CONSUMER_URL": "https://farmclub.kr",
        "EXPO_PUBLIC_PRODUCER_URL": "https://farm.farmclub.kr"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.farmclub.kr",
        "EXPO_PUBLIC_API_MOCK": "0",
        "EXPO_PUBLIC_CONSUMER_URL": "https://farmclub.kr",
        "EXPO_PUBLIC_PRODUCER_URL": "https://farm.farmclub.kr"
      }
    }
  },
  "submit": {
    "preview": {},
    "production": {}
  }
}
